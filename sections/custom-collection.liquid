{% comment %}
  Section: Our Collections
  Design: Nova web — UI Design (node 4009:410)
  Supports: Page-width layout, Theme Editor schema
{% endcomment %}

{% comment %} {{ 'section-collections.css' | asset_url | stylesheet_tag }} {% endcomment %}

<section
  class="collections-section"
  id="shopify-section-{{ section.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-primary: {{ section.settings.text_primary_color }};
    --text-secondary: {{ section.settings.text_secondary_color }};
    --btn-bg: {{ section.settings.button_bg_color }};
    --btn-text: {{ section.settings.button_text_color }};
  "
>
  <div class="collections-section__inner{% if section.settings.layout == 'full_width' %} collections-section__inner--full{% else %} page-width{% endif %}">

    {%- if section.settings.title != blank -%}
      <h2 class="collections-section__heading">
        {{ section.settings.title_plain }}
        <em>{{ section.settings.title_italic }}</em>
      </h2>
    {%- endif -%}

    <div class="collections-section__grid">

      {%- comment -%} LEFT COLUMN — two small cards + description + CTA {%- endcomment -%}
      <div class="collections-section__left">
        <div class="collections-section__small-cards">

          {%- for i in (1..2) -%}
            {%- assign card_image_key   = 'card_' | append: i | append: '_image' -%}
            {%- assign card_label_key   = 'card_' | append: i | append: '_label' -%}
            {%- assign card_name_key    = 'card_' | append: i | append: '_name' -%}
            {%- assign card_url_key     = 'card_' | append: i | append: '_url' -%}
            {%- assign card_image       = section.settings[card_image_key] -%}
            {%- assign card_label       = section.settings[card_label_key] -%}
            {%- assign card_name        = section.settings[card_name_key] -%}
            {%- assign card_url         = section.settings[card_url_key] -%}

            <a
              class="collections-section__card collections-section__card--small"
              href="{{ card_url | default: '#' }}"
            >
              <div class="collections-section__card-image">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 500, 700',
                      sizes: '(max-width: 768px) 45vw, 322px',
                      alt: card_name
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'collections-section__placeholder-img' }}
                {%- endif -%}
              </div>
              <div class="collections-section__card-details">
                <p class="collections-section__card-label">{{ card_label | default: 'COLLECTION' }}</p>
                <p class="collections-section__card-name">{{ card_name | default: 'Collection Name' }}</p>
              </div>
            </a>

          {%- endfor -%}
        </div>

        <div class="collections-section__description">
          {%- if section.settings.description != blank -%}
            <p class="collections-section__desc-text">{{ section.settings.description }}</p>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a
              class="collections-section__btn"
              href="{{ section.settings.button_url | default: '/collections' }}"
            >
              {{ section.settings.button_label }}
              <span class="collections-section__btn-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} RIGHT COLUMN — one large card {%- endcomment -%}
      {%- assign large_image   = section.settings.card_3_image -%}
      {%- assign large_label   = section.settings.card_3_label -%}
      {%- assign large_name    = section.settings.card_3_name -%}
      {%- assign large_url     = section.settings.card_3_url -%}

      <a
        class="collections-section__card collections-section__card--large"
        href="{{ large_url | default: '#' }}"
      >
        <div class="collections-section__card-image">
          {%- if large_image != blank -%}
            {{
              large_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '600, 800, 1000, 1400',
                sizes: '(max-width: 768px) 100vw, 668px',
                alt: large_name
            }}
          {%- else -%}
            {{ 'collection-2' | placeholder_svg_tag: 'collections-section__placeholder-img' }}
          {%- endif -%}
        </div>
        <div class="collections-section__card-details">
          <p class="collections-section__card-label">{{ large_label | default: 'COLLECTION' }}</p>
          <p class="collections-section__card-name">{{ large_name | default: 'Collection Name' }}</p>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  /* ─── Base ─────────────────────────────────────────────────────────────── */
  .collections-section {
    background-color: var(--section-bg, #faf9f6);
    border-top: 1px solid #e7e7e7;
    border-bottom: 1px solid #e7e7e7;
    padding-top: var(--section-padding-top, 80px);
    padding-bottom: var(--section-padding-bottom, 80px);
  }

  .collections-section__inner {
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding-inline: 40px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .collections-section__inner--full {
    max-width: 100%;
    padding-inline: 40px;
  }

  /* ─── Heading ───────────────────────────────────────────────────────────── */
  .collections-section__heading {
    color: var(--heading-color, #0a0a0a);
    font-family: 'Satoshi', sans-serif;
    font-weight: 300;
    font-size: clamp(48px, 6vw, 80px);
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
  }

  .collections-section__heading em {
    font-family: 'Didot', 'GFS Didot', 'Bodoni MT', Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }

  /* ─── Grid ──────────────────────────────────────────────────────────────── */
  .collections-section__grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
  }

  /* ─── Left column ───────────────────────────────────────────────────────── */
  .collections-section__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    flex: 0 0 auto;
    width: calc(50% - 16px);
    max-width: 668px;
    height: 879px;
  }

  .collections-section__small-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  /* ─── Description + CTA ─────────────────────────────────────────────────── */
  .collections-section__description {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 437px;
  }

  .collections-section__desc-text {
    color: var(--text-secondary, #959595);
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    line-height: 24px;
    margin: 0;
  }

  .collections-section__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--btn-bg, #08254f);
    color: var(--btn-text, #ffffff);
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    padding: 12px 20px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .collections-section__btn:hover {
    opacity: 0.85;
  }

  .collections-section__btn-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* ─── Cards ─────────────────────────────────────────────────────────────── */
  .collections-section__card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .collections-section__card:hover .collections-section__card-image img {
    transform: scale(1.04);
  }

  .collections-section__card-image {
    overflow: hidden;
    width: 100%;
    flex-shrink: 0;
  }

  .collections-section__card--small .collections-section__card-image {
    height: 383px;
  }

  .collections-section__card--large .collections-section__card-image {
    flex: 1 0 0;
    min-height: 0;
    height: 100%;
  }

  .collections-section__card-image img,
  .collections-section__card-image .collections-section__placeholder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  /* ─── Card details ──────────────────────────────────────────────────────── */
  .collections-section__card-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .collections-section__card-label {
    color: var(--text-secondary, #959595);
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0.04em;
  }

  .collections-section__card-name {
    color: var(--text-primary, #0a0a0a);
    font-family: 'Satoshi', sans-serif;
    font-size: 20px;
    line-height: 1.5;
    margin: 0;
  }

  /* ─── Right large card ──────────────────────────────────────────────────── */
  .collections-section__card--large {
    flex: 0 0 auto;
    width: calc(50% - 16px);
    max-width: 668px;
    height: 879px;
  }

  .collections-section__card--large .collections-section__card-image {
    flex: 1 0 0;
  }

  /* ─── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .collections-section__left,
    .collections-section__card--large {
      width: calc(50% - 12px);
      height: auto;
    }

    .collections-section__card--small .collections-section__card-image {
      height: 280px;
    }

    .collections-section__card--large .collections-section__card-image {
      height: 640px;
    }
  }

  @media (max-width: 768px) {
    .collections-section__inner {
      padding-inline: 20px;
      gap: 40px;
    }

    .collections-section__grid {
      flex-direction: column;
    }

    .collections-section__left,
    .collections-section__card--large {
      width: 100%;
      height: auto;
      max-width: 100%;
    }

    .collections-section__small-cards {
      grid-template-columns: 1fr 1fr;
    }

    .collections-section__card--small .collections-section__card-image {
      height: 220px;
    }

    .collections-section__card--large .collections-section__card-image {
      height: 480px;
    }

    .collections-section__heading {
      font-size: 40px;
      white-space: normal;
    }

    .collections-section__description {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .collections-section__small-cards {
      grid-template-columns: 1fr;
    }

    .collections-section__card--small .collections-section__card-image {
      height: 300px;
    }
  }
</style>

{% schema %}
{
  "name": "Our Collections",
  "tag": "section",
  "class": "section-our-collections",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section width",
      "options": [
        { "value": "page_width", "label": "Page width" },
        { "value": "full_width", "label": "Full width" }
      ],
      "default": "page_width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf9f6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_primary_color",
      "label": "Card name color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_secondary_color",
      "label": "Label / description color",
      "default": "#959595"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#08254f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title_plain",
      "label": "Heading — plain part",
      "default": "Our"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "Heading — italic part",
      "default": "Collections"
    },
    {
      "type": "header",
      "content": "Description & Button"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description text",
      "default": "Explore our signature styles — from timeless essentials to bold seasonal statements."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SEE ALL"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/collections"
    },
    {
      "type": "header",
      "content": "Card 1 (top left)"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Card 1 — Image"
    },
    {
      "type": "text",
      "id": "card_1_label",
      "label": "Card 1 — Label (e.g. COLLECTION)",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "card_1_name",
      "label": "Card 1 — Collection name",
      "default": "Summer Essentials"
    },
    {
      "type": "url",
      "id": "card_1_url",
      "label": "Card 1 — Link"
    },
    {
      "type": "header",
      "content": "Card 2 (top right of left column)"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Card 2 — Image"
    },
    {
      "type": "text",
      "id": "card_2_label",
      "label": "Card 2 — Label",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "card_2_name",
      "label": "Card 2 — Collection name",
      "default": "Autumn Statement"
    },
    {
      "type": "url",
      "id": "card_2_url",
      "label": "Card 2 — Link"
    },
    {
      "type": "header",
      "content": "Card 3 — Large (right column)"
    },
    {
      "type": "image_picker",
      "id": "card_3_image",
      "label": "Card 3 — Image"
    },
    {
      "type": "text",
      "id": "card_3_label",
      "label": "Card 3 — Label",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "card_3_name",
      "label": "Card 3 — Collection name",
      "default": "New Arrivals"
    },
    {
      "type": "url",
      "id": "card_3_url",
      "label": "Card 3 — Link"
    }
  ],
  "presets": [
    {
      "name": "Our Collections"
    }
  ]
}
{% endschema %}
