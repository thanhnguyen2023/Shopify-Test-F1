{%- style -%}
  .custom-rich-text-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    text-align: center;
  }

  .custom-rich-text-{{ section.id }} .heading {
    /* Sử dụng biến từ Schema để chỉnh size */
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 400;
    line-height: 1.1;
    margin-top: 0;
    margin-bottom: 2.4rem;
    color: #111111;
    word-break: break-word;
  }

  /* Chỉnh lại khoảng cách cho thẻ p bên trong Heading nếu người dùng xuống dòng */
  .custom-rich-text-{{ section.id }} .heading p {
    margin: 0;
    font-size: inherit;
    font-family: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .custom-rich-text-{{ section.id }} .heading em {
    font-style: italic;
    font-weight: 300;
  }

  .custom-rich-text-{{ section.id }} .description {
    font-size: 1.6rem;
    color: #555555;
    max-width: 80rem;
    margin: 0 auto 3.2rem auto;
    line-height: 1.5;
  }

  .custom-rich-text-{{ section.id }} .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    background-color: #0B2A4A;
    color: #ffffff;
    padding: 1.2rem 3.2rem;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    border-radius: 4px;
  }

  .custom-rich-text-{{ section.id }} .btn-primary svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* Responsive Mobile */
  @media screen and (max-width: 749px) {
    .custom-rich-text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
    .custom-rich-text-{{ section.id }} .heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="custom-rich-text-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="heading">
        {{ section.settings.heading }}
      </div>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <div class="description">{{ section.settings.description }}</div>
    {%- endif -%}
    
    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="btn-primary">
        {{ section.settings.btn_label }}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Rich Text",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Where <em>Minimalism</em> Meets Confidence</p>",
      "info": "Nhấn Shift + Enter để xuống dòng. Bôi đen chữ chọn 'I' để in nghiêng."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore and discover the latest trends in our exclusive range of products.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Custom Rich Text"
    }
  ]
}
{% endschema %}