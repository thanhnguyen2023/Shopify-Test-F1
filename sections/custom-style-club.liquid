{% comment %}
  Section: Nova – Style Club / Newsletter
  Design: Nova Web UI – Bottom Image (node 4123:852)
{% endcomment %}

{%- liquid
  assign section_id = 'nova-style-club-' | append: section.id
  assign form_id = 'nova-sc-form-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="nova-sc"
  style="
    min-height: {{ section.settings.section_height }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- comment %} ── Background image ── {%- endcomment %}
  <div class="nova-sc__bg" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'nova-sc__bg-img',
          alt: '',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw'
      }}
    {%- else -%}
      <div class="nova-sc__bg-placeholder"></div>
    {%- endif -%}

    {%- comment %} Right-side gradient overlay {%- endcomment %}
    <div
      class="nova-sc__overlay"
      style="
        background: linear-gradient(
          -90deg,
          rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
          rgba(0,0,0,0) {{ section.settings.overlay_fade }}%
        );
      "
    ></div>
  </div>

  {%- comment %} ── Content ── {%- endcomment %}
  <div class="nova-sc__inner page-width-full">
    <div class="nova-sc__content">
      {%- comment %} Heading + subtitle {%- endcomment %}
      <div class="nova-sc__text">
        <h2 class="nova-sc__heading" style="color: {{ section.settings.text_color }};">
          <span class="nova-sc__heading-italic">{{ section.settings.heading_italic | default: 'Join' }}</span>
          {{ section.settings.heading_rest | default: ' Our Style Club' }}
        </h2>

        {%- if section.settings.subheading != blank -%}
          <p class="nova-sc__subheading" style="color: {{ section.settings.text_color }};">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>

      {%- comment %} Email signup form {%- endcomment %}
      {%- form 'customer', id: form_id, class: 'nova-sc__form' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.customer_tag }}">

        {%- if form.posted_successfully? -%}
          <p class="nova-sc__success" style="color: {{ section.settings.text_color }};">
            {{ section.settings.success_message | default: 'Thank you for subscribing!' }}
          </p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="nova-sc__error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          <div class="nova-sc__form-row">
            <div class="nova-sc__input-wrap">
              <input
                id="{{ form_id }}-email"
                class="nova-sc__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                value="{{ form.email }}"
                placeholder="{{ section.settings.input_placeholder | default: 'Enter your Email' }}"
                style="
                  border-color: {{ section.settings.input_border_color }};
                  color: {{ section.settings.input_text_color }};
                "
                aria-label="{{ section.settings.input_placeholder | default: 'Enter your Email' }}"
              >
            </div>

            <button
              type="submit"
              class="nova-sc__btn"
              style="
                background-color: {{ section.settings.btn_bg_color }};
                color: {{ section.settings.btn_text_color }};
              "
            >
              {{ section.settings.btn_label | default: 'SUBSCRIBE' }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  /* ── Tokens ── */
  #{{ section_id }} {
    --nova-sc-text:         {{ section.settings.text_color }};
    --nova-sc-btn-bg:       {{ section.settings.btn_bg_color }};
    --nova-sc-btn-text:     {{ section.settings.btn_text_color }};
    --nova-sc-input-border: {{ section.settings.input_border_color }};
  }

  /* ── Section shell ── */
  .nova-sc {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Background ── */
  .nova-sc__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .nova-sc__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .nova-sc__bg-placeholder {
    position: absolute;
    inset: 0;
    background: #c9c5bc;
  }

  .nova-sc__overlay {
    position: absolute;
    inset: 0;
  }

  /* ── Inner / layout ── */
  .nova-sc__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: flex-end;
    padding-left: 40px;
    padding-right: 40px;
    box-sizing: border-box;
  }

  .nova-sc__content {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 553px;
    max-width: 100%;
  }

  /* ── Text ── */
  .nova-sc__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: var(--nova-sc-text);
  }

  .nova-sc__heading {
    font-family: 'Satoshi', sans-serif;
    font-size: clamp(48px, 5.5vw, 80px);
    font-weight: 300;
    line-height: 1.2;
    margin: 0;
    color: var(--nova-sc-text);
  }

  .nova-sc__heading-italic {
    font-family: 'Didot', 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
  }

  .nova-sc__subheading {
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
    max-width: 472px;
    color: var(--nova-sc-text);
  }

  /* ── Form ── */
  .nova-sc__form {
    width: 100%;
  }

  .nova-sc__form-row {
    display: flex;
    gap: 0;
    align-items: stretch;
    width: 100%;
  }

  .nova-sc__input-wrap {
    flex: 1 0 0;
    min-width: 0;
  }

  .nova-sc__input {
    display: block;
    width: 100%;
    height: 48px;
    padding: 12px 16px;
    background: #ffffff;
    border: 1px solid var(--nova-sc-input-border);
    border-right: none;
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--nova-sc-btn-text);
    box-sizing: border-box;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    border-radius: 0;
  }

  .nova-sc__input::placeholder {
    color: #c7c7c7;
  }

  .nova-sc__input:focus {
    border-color: #0a0a0a;
  }

  .nova-sc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 12px 20px;
    background-color: var(--nova-sc-btn-bg);
    color: var(--nova-sc-btn-text);
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
    border-radius: 0;
  }

  .nova-sc__btn:hover {
    opacity: 0.88;
  }

  /* ── States ── */
  .nova-sc__success {
    font-family: 'Satoshi', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
    color: var(--nova-sc-text);
  }

  .nova-sc__error {
    font-family: 'Satoshi', sans-serif;
    font-size: 14px;
    color: #ff5c5c;
    margin: 0 0 12px;
  }

  /* ── Responsive ── */
  @media screen and (max-width: 768px) {
    .nova-sc__inner {
      justify-content: flex-start;
      padding-left: 20px;
      padding-right: 20px;
    }

    .nova-sc__content {
      width: 100%;
      gap: 24px;
    }

    .nova-sc__overlay {
      background: linear-gradient(
        to top,
        rgba(0,0,0,0.65) 0%,
        rgba(0,0,0,0.2) 60%,
        rgba(0,0,0,0) 100%
      ) !important;
    }

    .nova-sc__form-row {
      flex-direction: column;
      gap: 12px;
    }

    .nova-sc__input {
      border-right: 1px solid var(--nova-sc-input-border);
    }

    .nova-sc__btn {
      width: 100%;
      height: 48px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Style Club",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Section height",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 160
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient overlay strength",
      "default": 60,
      "info": "Controls darkness of the right-side overlay."
    },
    {
      "type": "range",
      "id": "overlay_fade",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Gradient fade point",
      "default": 50,
      "info": "Point (%) where the overlay fades to transparent."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Italic word (Didot font)",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "heading_rest",
      "label": "Rest of heading",
      "default": " Our Style Club"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Unlock exclusive perks, early access to launches, and special birthday surprises."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Email form"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Enter your Email"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#e7e7e7"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input text color",
      "default": "#0a0a0a"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#08254f"
    },
    {
      "type": "text",
      "id": "customer_tag",
      "label": "Customer tag (for segmentation)",
      "default": "newsletter-style-club"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Custom Style Club"
    }
  ]
}
{% endschema %}
