{% comment %}
  Section: Best Sellers
  File: sections/best-sellers.liquid
{% endcomment %}

{%- liquid
  assign active_tab_index = 0
  assign tab_param = request.query.tab | default: request.params.tab
  if tab_param != blank
    assign active_tab_index = tab_param | plus: 0
  endif
-%}

<section
  class="bs-section"
  id="best-sellers-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --bs-bg: {{ section.settings.background_color }};
    --bs-text-primary: {{ section.settings.text_primary_color }};
    --bs-text-secondary: {{ section.settings.text_secondary_color }};
    --bs-accent: {{ section.settings.accent_color }};
    --bs-accent-text: {{ section.settings.accent_text_color }};
    --bs-padding-top: {{ section.settings.padding_top }}px;
    --bs-padding-bottom: {{ section.settings.padding_bottom }}px;
    --bs-card-image-height: {{ section.settings.card_image_height }}px;
  "
>
  <div class="bs-container">
    {%- comment -%} ── Header ── {%- endcomment -%}
    <div class="bs-header">
      <div class="bs-title-group">
        {%- if section.settings.heading != blank -%}
          <h2 class="bs-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bs-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ── Filter Tabs ── {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="bs-tabs" role="tablist">
          <button
            class="bs-tab{% if active_tab_index == 0 %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_tab_index == 0 %}true{% else %}false{% endif %}"
            data-tab="0"
            aria-controls="bs-panel-{{ section.id }}"
          >
            {{ section.settings.all_tab_label | default: 'ALL PRODUCTS' }}
          </button>

          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                class="bs-tab{% if forloop.index == active_tab_index %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.index == active_tab_index %}true{% else %}false{% endif %}"
                data-tab="{{ forloop.index }}"
                data-collection="{{ block.settings.collection.handle }}"
                aria-controls="bs-panel-{{ section.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | default: block.settings.collection.title }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Product Grid ── {%- endcomment -%}
    <div
      class="bs-grid"
      id="bs-panel-{{ section.id }}"
      role="tabpanel"
      data-products-container
    >
      {%- liquid
        assign source_collection = section.settings.default_collection
        assign products_limit = section.settings.products_limit | default: 6
        assign products_shown = 0
      -%}

      {%- if source_collection != blank -%}
        {%- for product in source_collection.products limit: products_limit -%}
          {%- assign products_shown = products_shown | plus: 1 -%}
          {%- render 'bs-product-card', product: product, section: section, index: forloop.index -%}
        {%- endfor -%}

        {%- if products_shown == 0 -%}
          <p class="bs-empty">No products found.</p>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Fallback: dùng featured_collection hoặc recent products {%- endcomment -%}
        {%- for product in collections.all.products limit: products_limit -%}
          {%- render 'bs-product-card', product: product, section: section, index: forloop.index -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} ── CTA Button ── {%- endcomment -%}
    {%- if section.settings.show_cta_button -%}
      <div class="bs-cta-wrap">
        <a
          class="bs-cta-btn"
          href="{% if section.settings.cta_collection != blank %}{{ section.settings.cta_collection.url }}{% else %}{{ routes.collections_url }}{% endif %}"
        >
          <span>{{ section.settings.cta_label | default: 'VIEW ALL PRODUCTS' }}</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%} ── Inline Product Card (snippet fallback nếu chưa có file riêng) ── {%- endcomment -%}
{% capture bs_card_html %}
{%- for product in source_collection.products limit: 1 -%}{%- endfor -%}
{% endcapture %}

<style>
  #best-sellers-{{ section.id }} {
    background-color: var(--bs-bg);
    padding-top: var(--bs-padding-top);
    padding-bottom: var(--bs-padding-bottom);
  }

  .bs-section .bs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
  }

  /* Header */
  .bs-section .bs-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 100%;
  }

  .bs-section .bs-title-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
    width: 100%;
  }

  .bs-section .bs-heading {
    font-family: 'Didot', 'Didot LT STD', 'Bodoni MT', Georgia, serif;
    font-style: italic;
    font-size: 80px;
    line-height: 1.2;
    color: var(--bs-text-primary);
    margin: 0;
  }

  .bs-section .bs-subheading {
    font-size: 16px;
    line-height: 1.5;
    color: var(--bs-text-secondary);
    max-width: 716px;
    margin: 0;
  }

  /* Tabs */
  .bs-section .bs-tabs {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bs-section .bs-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 0;
    border: 1px solid var(--bs-text-secondary);
    background: transparent;
    color: var(--bs-text-secondary);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .bs-section .bs-tab.is-active {
    background-color: var(--bs-accent);
    border-color: var(--bs-accent);
    color: var(--bs-accent-text);
    font-weight: 500;
  }

  .bs-section .bs-tab:hover:not(.is-active) {
    border-color: var(--bs-text-primary);
    color: var(--bs-text-primary);
  }

  /* Grid */
  .bs-section .bs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* Product Card */
  .bs-section .bs-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }

  .bs-section .bs-card__image-wrap {
    position: relative;
    overflow: hidden;
    height: var(--bs-card-image-height);
    background: #f0ede8;
  }

  .bs-section .bs-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .bs-section .bs-card:hover .bs-card__image-wrap img {
    transform: scale(1.04);
  }

  /* Quick-link icon button on card (chỉ card đầu tiên trong design) */
  .bs-section .bs-card__quick-link {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: white;
    color: #0a0a0a;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .bs-section .bs-card:hover .bs-card__quick-link {
    opacity: 1;
  }

  .bs-section .bs-card__details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 8px 0;
  }

  .bs-section .bs-card__title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--bs-text-primary);
    text-transform: uppercase;
    margin: 0;
    text-decoration: none;
    display: block;
  }

  .bs-section .bs-card__title:hover {
    text-decoration: underline;
  }

  .bs-section .bs-card__price {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--bs-text-primary);
    margin: 0;
  }

  .bs-section .bs-card__price s {
    color: var(--bs-text-secondary);
    margin-left: 8px;
    font-size: 16px;
  }

  /* CTA */
  .bs-section .bs-cta-wrap {
    display: flex;
    justify-content: center;
  }

  .bs-section .bs-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background-color: var(--bs-accent);
    color: var(--bs-accent-text);
    font-size: 16px;
    line-height: 1.5;
    font-weight: 400;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .bs-section .bs-cta-btn:hover {
    opacity: 0.85;
  }

  .bs-section .bs-empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--bs-text-secondary);
    padding: 40px 0;
  }

  /* Loading state */
  .bs-section .bs-grid.is-loading {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .bs-section .bs-heading { font-size: 60px; }
    .bs-section .bs-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .bs-section .bs-container {
      padding-left: 20px;
      padding-right: 20px;
      gap: 40px;
    }
    .bs-section .bs-heading { font-size: 40px; }
    .bs-section .bs-subheading { font-size: 14px; }
    .bs-section .bs-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .bs-section .bs-tabs { gap: 12px; }
    .bs-section .bs-tab { padding: 10px 14px; font-size: 14px; }
  }

  @media (max-width: 480px) {
    .bs-section .bs-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('best-sellers-{{ section.id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.bs-tab');
    var grid = section.querySelector('[data-products-container]');

    function setActiveTab(btn) {
      tabs.forEach(function (t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
    }

    function loadCollection(handle) {
      if (!handle) return;
      grid.classList.add('is-loading');

      var limit = {{ section.settings.products_limit | default: 6 }};
      var url = '/collections/' + handle + '/products.json?limit=' + limit;

      fetch(url)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var products = data.products;
          if (!products || products.length === 0) {
            grid.innerHTML = '<p class="bs-empty">No products found.</p>';
            return;
          }

          var html = '';
          products.forEach(function (p) {
            var imgSrc = p.images && p.images[0]
              ? p.images[0].src
              : 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_medium.png';
            var price = (p.variants[0].price / 100).toFixed(2);
            var comparePrice = p.variants[0].compare_at_price
              ? '<s>$' + (p.variants[0].compare_at_price / 100).toFixed(2) + '</s>'
              : '';

            html += '<div class="bs-card">';
            html += '<div class="bs-card__image-wrap">';
            html += '<a href="/products/' + p.handle + '" tabindex="-1" aria-hidden="true">';
            html += '<img src="' + imgSrc + '" alt="' + p.title + '" loading="lazy" width="600" height="750">';
            html += '</a>';
            html += '<a class="bs-card__quick-link" href="/products/' + p.handle + '" aria-label="View ' + p.title + '">';
            html += '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            html += '</a>';
            html += '</div>';
            html += '<div class="bs-card__details">';
            html += '<a class="bs-card__title" href="/products/' + p.handle + '">' + p.title + '</a>';
            html += '<p class="bs-card__price">$' + price + comparePrice + '</p>';
            html += '</div>';
            html += '</div>';
          });

          grid.innerHTML = html;
        })
        .catch(function () {
          grid.innerHTML = '<p class="bs-empty">Could not load products.</p>';
        })
        .finally(function () {
          grid.classList.remove('is-loading');
        });
    }

    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setActiveTab(btn);
        var tabIndex = btn.getAttribute('data-tab');
        var collectionHandle = btn.getAttribute('data-collection');

        if (tabIndex === '0' || !collectionHandle) {
          // "All Products" — reload trang để lấy lại server render
          window.location.href = window.location.pathname + '?tab=0';
        } else {
          loadCollection(collectionHandle);
        }
      });
    });
  })();
</script>

{% comment %}
  ── Inline product card render (dùng khi không có snippet riêng) ──
  Đặt đây để section tự render khi load lần đầu từ server.
{% endcomment %}

{%- comment -%}
  NOTE: Nếu muốn tách snippet riêng, tạo file snippets/bs-product-card.liquid
  với nội dung render card từ biến `product`.
  Ví dụ: {% render 'bs-product-card', product: product, section: section %}
{%- endcomment -%}

{%- assign _source = section.settings.default_collection -%}
{%- assign _limit = section.settings.products_limit | default: 6 -%}

{%- comment -%}
  Vì Liquid không thể render 2 lần vào cùng 1 element,
  section đã render cards ở trên (trong .bs-grid).
  Script sẽ thay thế nội dung khi user click tab.
  Phần dưới là snippet tái sử dụng được gọi bởi render tag bên trong bs-grid.
{%- endcomment -%}

{% schema %}
{
