      "id": "products_limit",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Number of products to show",
      "default": 6
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "checkbox",
      "id": "show_cta_button",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "collection",
      "id": "cta_collection",
      "label": "Button destination (collection)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
